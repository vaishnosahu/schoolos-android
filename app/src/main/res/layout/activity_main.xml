<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9FD">

    <WebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F7F9FD" />

    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_gravity="top"
        android:max="100"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/offlinePanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F7F9FD"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SchoolOS is offline"
            android:textColor="#172033"
            android:textSize="22sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Check your connection and retry. Your live school data stays on the SchoolOS server."
            android:textColor="#667085"
            android:textSize="14sp" />
        <Button
            android:id="@+id/retryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Retry" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/launchOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/launch_background"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingLeft="32dp"
            android:paddingRight="32dp">

            <FrameLayout
                android:id="@+id/launchLogo"
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:background="@drawable/launch_logo_plate"
                android:elevation="10dp"
                android:padding="18dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="SchoolOS"
                    android:src="@drawable/ic_schoolos" />
            </FrameLayout>

            <TextView
                android:id="@+id/launchTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center"
                android:text="Welcome to SchoolOS"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/launchSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="Your school. One connected workspace."
                android:textColor="#DDE5FF"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="34dp"
                android:gravity="center"
                android:orientation="horizontal">

                <View
                    android:id="@+id/launchDot1"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_margin="6dp"
                    android:alpha="1"
                    android:background="@drawable/launch_dot" />

                <View
                    android:id="@+id/launchDot2"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_margin="6dp"
                    android:alpha=".34"
                    android:background="@drawable/launch_dot" />

                <View
                    android:id="@+id/launchDot3"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_margin="6dp"
                    android:alpha=".34"
                    android:background="@drawable/launch_dot" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Preparing your workspace"
                android:textColor="#BFCBFF"
                android:textSize="11sp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
