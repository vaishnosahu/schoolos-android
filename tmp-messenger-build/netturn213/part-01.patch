+    private fun triggerCallIceRestart(reason:String) {
+        val current=activeVoiceCall ?: return
+        if(current.incoming || !networkAvailable) return
+        val now=System.currentTimeMillis()
+        if(now-lastIceRestartAtMs < 3_000L) return
+        val restarted=voiceEngine?.restartIceAndCreateOffer() == true
+        if(restarted){
+            lastIceRestartAtMs=now
+            callReconnectCount++
+            callDiagnostics=callDiagnostics.copy(reconnectCount=callReconnectCount,networkLabel=currentCallNetworkLabel())
+            activeVoiceCall=current.copy(phase=VoiceCallPhase.RECONNECTING,error=null)
+            scheduleCallReconnectDeadline()
+        }
+    }
+
+    private fun scheduleCallReconnectDeadline() {
+        val callId=activeVoiceCall?.callId ?: return
+        callReconnectJob?.cancel()
+        callReconnectJob=viewModelScope.launch {
+            delay(20_000L)
+            val current=activeVoiceCall
+            if(current?.callId==callId && current.phase in setOf(VoiceCallPhase.RECONNECTING,VoiceCallPhase.FAILED,VoiceCallPhase.CONNECTING)){
+                activeVoiceCall=current.copy(phase=VoiceCallPhase.FAILED,error="Connection lost")
+                delay(900L)
+                if(activeVoiceCall?.callId==callId) endVoiceCall("network_lost")
+            }
+        }
+    }
