<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9FD">

    <WebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F7F9FD" />

    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_gravity="top"
        android:max="100"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/offlinePanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F7F9FD"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SchoolOS is offline"
            android:textColor="#172033"
            android:textSize="22sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Check your connection and retry. Your live school data stays on the SchoolOS server."
            android:textColor="#667085"
            android:textSize="14sp" />
        <Button
            android:id="@+id/retryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Retry" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/launchOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/launch_background"
        android:clickable="true"
        android:focusable="true">

        <View
            android:id="@+id/launchOrb1"
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:layout_gravity="top|right"
            android:layout_marginTop="-74dp"
            android:layout_marginRight="-82dp"
            android:alpha=".16"
            android:background="@drawable/launch_orb" />

        <View
            android:id="@+id/launchOrb2"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_gravity="bottom|left"
            android:layout_marginBottom="-70dp"
            android:layout_marginLeft="-70dp"
            android:alpha=".12"
            android:background="@drawable/launch_orb" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingLeft="32dp"
            android:paddingRight="32dp">

            <FrameLayout
                android:layout_width="146dp"
                android:layout_height="146dp">

                <View
                    android:id="@+id/launchRing"
                    android:layout_width="128dp"
                    android:layout_height="128dp"
                    android:layout_gravity="center"
                    android:alpha=".42"
                    android:background="@drawable/launch_ring" />

                <FrameLayout
                    android:id="@+id/launchLogo"
                    android:layout_width="104dp"
                    android:layout_height="104dp"
                    android:layout_gravity="center"
                    android:background="@drawable/launch_logo_plate"
                    android:elevation="12dp"
                    android:padding="18dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="SchoolOS"
                        android:src="@drawable/ic_schoolos" />
                </FrameLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/launchTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="Welcome to SchoolOS"
                android:textColor="#FFFFFF"
                android:textSize="29sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/launchSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="Your school. One connected workspace."
                android:textColor="#E4E9FF"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:gravity="center"
                android:text="Students • Teachers • Parents • Operations"
                android:textColor="#BFCBFF"
                android:textSize="11sp" />

            <FrameLayout
                android:layout_width="210dp"
                android:layout_height="4dp"
                android:layout_marginTop="32dp"
                android:background="@drawable/launch_progress_track">

                <View
                    android:id="@+id/launchProgress"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/launch_progress_fill" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center"
                android:orientation="horizontal">

                <View
                    android:id="@+id/launchDot1"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_margin="6dp"
                    android:alpha="1"
                    android:background="@drawable/launch_dot" />

                <View
                    android:id="@+id/launchDot2"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_margin="6dp"
                    android:alpha=".34"
                    android:background="@drawable/launch_dot" />

                <View
                    android:id="@+id/launchDot3"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_margin="6dp"
                    android:alpha=".34"
                    android:background="@drawable/launch_dot" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:text="Preparing your workspace"
                android:textColor="#C9D3FF"
                android:textSize="11sp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
